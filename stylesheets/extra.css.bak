}

/*  */
.md-typeset .admonition.vidcast,
.md-typeset details.vidcast {
  border-color: rgb(215, 65, 135);
}
.md-typeset .admonition.download,
.md-typeset details.download {
  border-color: rgb(203, 203, 202);
}

.md-typeset .admonition.blank,
.md-typeset details.blank {
  border-color: rgb(112, 112, 112);
}

.md-typeset .admonition.cedeploy,
.md-typeset details.cedeploy {
  border-color: rgb(0, 124, 255);
}

.md-typeset .admonition.webex,
.md-typeset details.webex {
  border-color: rgb(38, 83, 208);
}

.md-typeset .admonition.gif,
.md-typeset details.gif {
  border-color: rgb(205, 27, 212);
}

.md-typeset .admonition.important,
.md-typeset details.important {
  border-color: rgb(255, 0, 0);
}

.md-typeset .admonition.challenge,
.md-typeset details.challenge {
  border-color: rgb(255, 215, 0);
}

.md-typeset .admonition.tool,
.md-typeset details.tool {
  border-color: rgb(192, 192, 192);
}

.md-typeset .admonition.curious,
.md-typeset details.curious {
  border-color: rgb(255, 159, 249);
}

.md-typeset .admonition.lesson,
.md-typeset details.lesson {
  border-color: rgb(255, 255, 255);
}

/* */
.md-typeset .vidcast > .admonition-title,
.md-typeset .vidcast > summary {
  background-color: rgba(215, 65, 135, 0.1);
}
.md-typeset .download > .admonition-title,
.md-typeset .download > summary {
  background-color: rgba(108, 108, 108, 0.1);
}
.md-typeset .blank > .admonition-title,
.md-typeset .blank > summary {
  background-color: rgba(108, 108, 108, 0.1);
}

.md-typeset .cedeploy > .admonition-title,
.md-typeset .cedeploy > summary {
  background-color: rgba(0, 124, 255, 0.1);
}

.md-typeset .webex > .admonition-title,
.md-typeset .webex > summary {
  background-color: rgb(38, 83, 208, 0.1);
}

.md-typeset .gif > .admonition-title,
.md-typeset .gif > summary {
  background-color: rgb(205, 27, 212, 0.1);
}

.md-typeset .important > .admonition-title,
.md-typeset .important > summary {
  background-color: rgba(255, 0, 0, 0.1);
}

.md-typeset .challenge > .admonition-title,
.md-typeset .challenge > summary {
  background-color: rgba(255, 215, 0, 0.1);
}

.md-typeset .challenge > .admonition-title,
.md-typeset .challenge > summary {
  background-color: rgba(192, 192, 192, 0.1);
}

.md-typeset .curious > .admonition-title,
.md-typeset .curious > summary {
  background-color: rgba(255, 159, 249, 0.1);
}

.md-typeset .lesson > .admonition-title,
.md-typeset .lesson > summary {
  background-color: rgba(0, 0, 0, 0.1);
}

/*  */
.md-typeset .vidcast > .admonition-title::before,
.md-typeset .vidcast > summary::before {
  background-color: rgb(215, 65, 135);
  background: linear-gradient(45deg, #4f62ff 25%, #f15a6f 60%);
  -webkit-mask-image: var(--md-admonition-icon--vidcast);
          mask-image: var(--md-admonition-icon--vidcast);
}

.md-typeset .download > .admonition-title::before,
.md-typeset .download > summary::before {
  background-color: rgb(203, 203, 202);
  -webkit-mask-image: var(--md-admonition-icon--download);
          mask-image: var(--md-admonition-icon--download);
}

.md-typeset .blank > .admonition-title::before,
.md-typeset .blank > summary::before {
  background-color: rgb(112, 112, 112);
  -webkit-mask-image: var(--md-admonition-icon--blank);
          mask-image: var(--md-admonition-icon--blank);
}

.md-typeset .cedeploy > .admonition-title::before,
.md-typeset .cedeploy > summary::before {
  background-color: rgb(255, 255, 255);
  background: linear-gradient(45deg, #357AF7 25%, #53A451 75%);
  -webkit-mask-image: var(--md-admonition-icon--cedeploy);
          mask-image: var(--md-admonition-icon--cedeploy);
}

.md-typeset .webex > .admonition-title::before,
.md-typeset .webex > summary::before {
  background-color: rgb(255, 255, 255);
  background: linear-gradient(45deg, #19c9ff 25%, #2f62f3 50%, #5aee4e 75%);
  -webkit-mask-image: var(--md-admonition-icon--webex);
